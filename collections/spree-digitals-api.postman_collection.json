          "request": {
            "name": "Download a digital product",
            "description": {
              "content": "Downloads a digital product file using the digital link token.\nThe token is provided via the `download_url` field on digital links\nreturned with order line items. No API key or authentication required —\nthe token itself grants access.\nEach download increments the access counter. Downloads may be limited by\nstore settings (number of downloads and/or time-based expiration).\n",
              "type": "text/plain"
            },
